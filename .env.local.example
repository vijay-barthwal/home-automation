# Copy this file to .env.local and fill in real values.
# .env.local is already gitignored — it will never be committed.

# The Gmail address that will SEND the contact-form emails.
GMAIL_USER=youraddress@gmail.com

# A Gmail "App Password" (NOT your normal Gmail password).
# Generate one at: https://myaccount.google.com/apppasswords
# Requires 2-Step Verification to be enabled on the Google account.
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Where inquiries should be delivered. Defaults to GMAIL_USER if omitted.
CONTACT_TO_EMAIL=youraddress@gmail.com
