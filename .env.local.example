# Copy this file to .env.local and fill in real values.
# .env.local is already gitignored — it will never be committed.

# SMTP settings for the contact-form email (works with any provider).
#
# GoDaddy / Microsoft 365 (default host/port below):
#   SMTP_USER = your full GoDaddy email address
#   SMTP_PASSWORD = an app password from https://mysignins.microsoft.com/security-info
#                   (MFA must be enabled first — see "Add sign-in method" > "App password")
#
# Gmail instead: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, and an app password
# from https://myaccount.google.com/apppasswords (requires 2-Step Verification).
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=info@infiniteiot.in
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
CONTACT_TO_EMAIL=info@infiniteiot.in

# The production URL this site is deployed at (no trailing slash).
# Used for canonical URLs, sitemap.xml, robots.txt, and structured data.
# Only needed to override the default in site-config.ts (e.g. for a preview
# deployment) — production already defaults to the real domain below.
NEXT_PUBLIC_SITE_URL=https://www.infiniteiot.in

# Social links shown in the footer. All optional — leave any of them unset
# (or delete the line) to simply hide that icon. Must be NEXT_PUBLIC_ to be
# readable in the browser.
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/infiniteautomation
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/infiniteautomation
NEXT_PUBLIC_YOUTUBE_URL=https://youtube.com/@infiniteautomation
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/company/infiniteautomation
